<?xml version="1.0" encoding="utf-8"?>
<!-- Personal offline Catan home: phone-landscape layout, with scrollable options. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/start_sea_background"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <!-- Simple illustrated title: nothing here blocks starting a game. -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.86"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CATAN"
            android:textSize="48sp"
            android:fontFamily="sans-serif-black"
            android:textStyle="bold"
            android:letterSpacing="0.07"
            android:textColor="#FFF1CE89"
            android:shadowColor="#66000000"
            android:shadowDx="2"
            android:shadowDy="3"
            android:shadowRadius="4"
            android:singleLine="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="THE ISLAND AWAITS"
            android:letterSpacing="0.13"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFF6DF" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="64dp"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/terrain_lumber"
                android:contentDescription="Forest" />

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/terrain_grain"
                android:contentDescription="Fields" />

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/terrain_ore"
                android:contentDescription="Mountains" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Build settlements. Trade resources. Outsmart three rivals."
            android:textSize="13sp"
            android:textColor="#FFDEF3EF"
            android:lineSpacingExtra="2dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="OFFLINE · SINGLE PLAYER"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:textSize="11sp"
            android:textColor="#FFF1CE89" />
    </LinearLayout>

    <!-- Right side is a card; the player list scrolls separately from actions. -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.14"
        android:background="@drawable/start_setup_card"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NEW GAME"
            android:textSize="23sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:textColor="#FF254B3F" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Choose your island and computer opponents"
            android:textSize="12sp"
            android:textColor="#FF655B46"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="3dp">

            <LinearLayout android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginEnd="6dp">
                <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BOARD SIZE" android:textStyle="bold"
                    android:textColor="#FF254B3F" android:textSize="10sp" />
                <Spinner android:id="@+id/new_game_island"
                    android:layout_width="match_parent"
                    android:layout_height="38dp" />
            </LinearLayout>

            <LinearLayout android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="6dp">
                <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="COMPUTER OPPONENTS" android:textStyle="bold"
                    android:textColor="#FF254B3F" android:textSize="10sp" />
                <Spinner android:id="@+id/new_game_opponents"
                    android:layout_width="match_parent"
                    android:layout_height="38dp" />
            </LinearLayout>
        </LinearLayout>

        <TextView android:id="@+id/new_game_island_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Classic · 19 tiles · Official 3–4 player island"
            android:textColor="#FF655B46"
            android:textSize="10sp"
            android:layout_marginBottom="4dp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="false"
            android:scrollbars="vertical"
            android:fadeScrollbars="true">
            <include
                layout="@layout/game_config_tabhost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </ScrollView>

        <Button
            android:id="@+id/continueGameButton"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/start_secondary_button"
            android:text="Continue saved game"
            android:contentDescription="Continue the last automatically saved game"
            android:textColor="#FF214E3E"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="7dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/saveConfigButton"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="11dp"
                android:paddingEnd="11dp"
                android:background="@drawable/start_secondary_button"
                android:text="Save setup"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textColor="#FF3F4436" />

            <Button
                android:id="@+id/playGameButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="9dp"
                android:background="@drawable/start_play_button"
                android:text="Start new game  ›"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#FFFFF7E5" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
