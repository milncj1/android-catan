<?xml version="1.0" encoding="utf-8"?>
<TableRow xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <EditText
        android:id="@+id/playerNameEditText"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="40dp"
        android:layout_marginEnd="5dp"
        android:singleLine="true"
        android:maxLines="1"
        android:selectAllOnFocus="true"
        android:inputType="textPersonName"
        android:background="@drawable/start_player_field"
        android:paddingStart="9dp"
        android:paddingEnd="7dp"
        android:textSize="14sp"
        android:textColor="#FF2F4039"
        android:hintTextColor="#FF777567" />

    <Spinner
        android:id="@+id/playerTypeSpinner"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="40dp"
        android:background="@drawable/start_player_field"
        android:paddingStart="6dp"
        android:paddingEnd="4dp"
        android:spinnerMode="dropdown" />

    <!-- Fixed four-player game; retain the ID expected by legacy Java. -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone">
        <ImageButton
            android:id="@+id/delPlayerButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:contentDescription="@string/remove_player" />
    </FrameLayout>
</TableRow>
