<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/localTabLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TableLayout
        android:id="@+id/configTableLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stretchColumns="0,1">

        <!-- Original game framework still looks for this deprecated IP label. -->
        <TextView
            android:id="@+id/ipCodeLabel"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text=""
            android:visibility="gone" />

        <TableRow
            android:id="@+id/tableHeadingRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="3dp">

            <TextView
                android:id="@+id/playerNameHeadingText"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:paddingStart="7dp"
                android:text="PLAYER"
                android:textStyle="bold"
                android:letterSpacing="0.07"
                android:textSize="11sp"
                android:textColor="#FF605840" />

            <TextView
                android:id="@+id/playerTypeHeadingText"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:paddingStart="7dp"
                android:text="CONTROLLED BY"
                android:textStyle="bold"
                android:letterSpacing="0.07"
                android:textSize="11sp"
                android:textColor="#FF605840" />
        </TableRow>
    </TableLayout>

    <!-- Fixed four-player personal Catan. GameMainActivity still binds this. -->
    <Button
        android:id="@+id/addPlayerButton"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:text="@string/add_player" />
</LinearLayout>
